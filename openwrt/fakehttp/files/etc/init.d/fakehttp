#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/fakehttp
NAME=fakehttp

. /lib/functions.sh
. /lib/functions/network.sh
. /lib/functions/procd.sh

append_flag()
{
	local section="$1"
	local option="$2"
	local flag="$3"
	local value

	config_get_bool value "$section" "$option" 0
	[ "$value" -eq 1 ] && procd_append_param command "$flag"
}

append_number()
{
	local section="$1"
	local option="$2"
	local flag="$3"
	local value

	config_get value "$section" "$option" "-1"
	[ "$value" -gt 0 ] 2>/dev/null && procd_append_param command "$flag" "$value"
}

append_interface()
{
	local value="$1"
	local dev

	[ -n "$value" ] || return 0

	if network_get_device dev "$value"; then
		value="$dev"
	fi

	procd_append_param command -i "$value"
	procd_append_param netdev "$value"
}

append_payload()
{
	local section="$1"
	local enabled type payload

	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get type "$section" type ""
	config_get payload "$section" payload ""
	[ -n "$payload" ] || return 0

	case "$type" in
		http) procd_append_param command -h "$payload" ;;
		https) procd_append_param command -e "$payload" ;;
		binary) procd_append_param command -b "$payload" ;;
	esac
}

append_advanced()
{
	append_flag advanced skip -f
	append_flag advanced disable_estimation -g
	append_number advanced pct -y
	append_number advanced fwmark_bypassing -m
	append_number advanced fwmark_handle -x
	append_number advanced queue_number -n
	append_number advanced repeat -r
	append_number advanced ttl -t
	append_flag advanced use_iptables -z
}

start_service()
{
	local enabled

	network_flush_cache
	config_load "$NAME"
	config_get_bool enabled globals enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	config_list_foreach globals interface append_interface
	append_flag globals silent -s
	config_foreach append_payload payload
	append_advanced
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

reload_service()
{
	stop
	start
}

service_triggers()
{
	procd_add_reload_trigger "$NAME"
}
